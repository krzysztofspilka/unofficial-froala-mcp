{
  "name": "@froala/mcp",
  "version": "0.2.0",
  "description": "MCP server for the Froala rich text editor. Lets AI coding assistants set up Froala, find presets, audit Froala code and read the Froala docs.",
  "type": "module",
  "mcpName": "com.froala/mcp",
  "bin": {
    "froala-mcp": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:content": "node --disable-warning=ExperimentalWarning scripts/build-content.mjs",
    "build:knowledge": "node scripts/build-knowledge.mjs",
    "build:data": "node scripts/build-data.mjs",
    "typecheck": "tsc && tsc -p kit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node test/browser/enhancements.mjs && node test/browser/presets.mjs",
    "test:apps": "node eval/run-apps.mjs",
    "test:eval": "node eval/run-questions.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev": "wrangler dev",
    "predeploy": "npm run check:data",
    "deploy": "wrangler deploy",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/stdio.js",
    "prepublishOnly": "npm run check:data && npm run typecheck && npm test && npm run build",
    "check:data": "node scripts/check-data.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "froala",
    "wysiwyg",
    "rich-text-editor",
    "ai"
  ],
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "froala-editor": "^5.5.0",
    "jsdom": "^29.1.1",
    "minisearch": "^7.2.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prismjs": "^1.30.0",
    "semver": "^7.8.5",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0",
    "zod": "^4.6.6"
  }
}
