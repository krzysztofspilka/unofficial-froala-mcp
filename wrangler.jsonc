{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "froala-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The licensing text is bundled as plain text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // 120 tool calls a minute for each IP address.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "observability": { "enabled": true }
}
